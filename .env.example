# Browser-safe Supabase settings. Replace with values from your Supabase project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only; required by api/invite-member.js. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional server-only direct PostgreSQL connection for future server routes.
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/postgres
