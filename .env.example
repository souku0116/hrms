# Browser-safe Supabase settings. Prefer the publishable key for new Supabase projects.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable-your-key

# Server-only; required by privileged API routes. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret-your-key
# Legacy server key name (supported for existing projects during migration).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only Groq key for AI resume parsing. Never use a VITE_ prefix.
GROQ_API_KEY=your-groq-api-key
# Optional; defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional server-only direct PostgreSQL connection for future server routes.
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/postgres
